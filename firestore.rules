rules_version = '2';

// Copy all of this into Firebase console > Firestore Database > Rules, then click Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Paid and not expired. Access docs without expiresAt are older lifetime purchases.
    function hasPaid() {
      let path = /databases/$(database)/documents/access/$(request.auth.uid);
      return signedIn() && exists(path)
        && (!('expiresAt' in get(path).data) || get(path).data.expiresAt > request.time.toMillis());
    }

    // Admin list: created by hand in the console
    match /admins/{uid} {
      allow read: if isMe(uid);
      allow write: if false;
    }

    // Paper list and papers: written only by the Paper Manager (service account).
    // Free papers open to any logged-in user, the rest only to paid students and admins.
    // The paper list (titles and counts only) is public so the home page can show it
    match /meta/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /papers/{paperId} {
      allow read: if signedIn() && (resource.data.free == true || hasPaid() || isAdmin());
      allow write: if false;
    }

    // Paid access: only admins can give or remove it
    match /access/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // "I have paid" requests: students send their own, admins approve or reject
    match /payments/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create: if isMe(uid) && validPayment();
      // students can send a new request any time (to fix a typo or renew); it always starts as pending
      allow update: if (isMe(uid) && validPayment()) || isAdmin();
      allow delete: if isAdmin();
    }
    function validPayment() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'email', 'ref', 'method', 'amount', 'createdAt', 'status'])
        && d.status == 'pending'
        && d.ref is string && d.ref.size() > 3 && d.ref.size() <= 100
        && d.name is string && d.name.size() <= 80;
    }

    // Toppers: one entry per student per paper, from their FIRST attempt only.
    // Any logged-in user can read (names and scores only). Students can create
    // their own entry once and never change it; admins can rebuild or delete.
    match /leaderboards/{paperId}/entries/{uid} {
      allow read: if signedIn();
      allow create: if isMe(uid) && validEntry();
      allow update, delete: if isAdmin();
      allow create: if isAdmin();
    }
    function validEntry() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'score', 'max', 'correct', 'wrong', 'timeTaken', 'submittedAt', 'attemptId'])
        && d.name is string && d.name.size() <= 80
        && d.score is number && d.max is number && d.score <= d.max && d.max <= 1000
        && d.timeTaken is number && d.timeTaken >= 0
        && d.attemptId is string;
    }

    // Student profile
    match /users/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80;
      allow delete: if isAdmin();

      // Test in progress (answers + timer), one doc per paper
      match /progress/{paperId} {
        allow read, write: if isMe(uid);
        allow read: if isAdmin();
      }
    }

    // Submitted tests. Students add their own and can't edit them afterwards.
    match /attempts/{attemptId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.answers is map
        && request.resource.data.paperId is string;
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
